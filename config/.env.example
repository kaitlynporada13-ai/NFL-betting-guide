# Copy this to .env and fill in your API keys
# DO NOT commit .env to version control

# The Odds API - https://the-odds-api.com/ (free tier: 500 requests/month)
ODDS_API_KEY=your_odds_api_key_here

# Visual Crossing Weather - https://www.visualcrossing.com/ (free tier: 1000 requests/day)
WEATHER_API_KEY=your_weather_api_key_here

# PropLine - https://prop-line.com (free tier: 1,000 requests/day)
# For historical prop lines + graded results (backtesting)
PROPLINE_API_KEY=your_propline_api_key_here
