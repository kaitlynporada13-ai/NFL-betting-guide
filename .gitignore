# ...except the 5 pick files the deployed app reads (regenerated weekly)
!data/processed/prop_projections_latest.parquet
!data/processed/totals_picks_latest.parquet
!data/processed/spreads_picks_latest.parquet
!data/processed/specials_picks_latest.parquet
!data/processed/anytime_td_picks_latest.parquet

# Model artifacts
models/trained/*.pkl
models/trained/*.joblib

# ...except the blended prop projection models + their OOS report (used live by the app)
!models/trained/proj_player_pass_tds.pkl
!models/trained/proj_player_pass_yds.pkl
!models/trained/proj_player_rush_yds.pkl
!models/trained/proj_player_receptions.pkl
!models/trained/proj_player_reception_yds.pkl
